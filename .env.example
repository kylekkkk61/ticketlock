# Copy to .env in the repository root. Never commit .env.
# The contracts scripts and the web app both read this one file.

# Server only: the platform account that deploys, issues tickets and pays gas.
# Fund it with Base Sepolia test ETH. Consumers and the organiser never need ETH.
RELAYER_PRIVATE_KEY=0x

# Server only: Privy app secret. The app ID is public.
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: Alchemy key for server-side Base Sepolia RPC. Falls back to https://sepolia.base.org.
ALCHEMY_API_KEY=

# Optional: only needed to verify the contract source on Basescan.
ETHERSCAN_API_KEY=

# Which deployment manifest the web app uses: local | base-sepolia
TICKETLOCK_NETWORK=base-sepolia

# Public HTTPS address of the app. The organiser's entry QR code points here.
APP_URL=https://ticketlock.example.com

# Optional, for deploy/push.sh: the demo host as user@address.
TICKETLOCK_HOST=

# Optional, for recording/: the emails of the three demo accounts.
TICKETLOCK_ORGANISER=
TICKETLOCK_ALICE=
TICKETLOCK_BOB=
